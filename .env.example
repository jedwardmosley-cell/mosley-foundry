# PostgreSQL connection string. In production this comes from your database provider (e.g. Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Direct (non-pooled) connection for creating tables. Vercel's Neon integration sets this for you.
# With other providers, use the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Optional. Enables the AI Coaching Companion. Without it the companion is disabled
# and the rest of the app works normally. Never commit a real key.
ANTHROPIC_API_KEY=""

# Days to keep AI conversations before automatic deletion (participants can choose shorter).
AI_RETENTION_DAYS_DEFAULT="90"

# Secret used once at /setup to create the first administrator and upload the content pack.
# Use a long random value. You can remove it after setup.
SETUP_TOKEN=""

# Set to "false" to turn off public sign-up (administrators can still enroll people).
ALLOW_SIGNUP="true"

# Optional. Sends forgot-password emails through Resend (resend.com). Without them, people ask their coach.
RESEND_API_KEY=""
EMAIL_FROM="Both Hands on the Wheel <noreply@mosleyfoundry.com>"
# Optional. The public address used in email links. Defaults to the Vercel production address.
APP_URL=""
# Local testing only: write emails to this file instead of sending them.
# EMAIL_DEV_OUTBOX="/tmp/outbox.jsonl"
