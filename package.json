{
  "name": "both-hands-on-the-wheel",
  "version": "0.1.0",
  "private": true,
  "description": "Both Hands on the Wheel: personal leadership and coaching platform (Mosley Foundry)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push && tsx prisma/seed.ts",
    "content:build": "python3 -I scripts/build-content-pack.py",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/workflow.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
